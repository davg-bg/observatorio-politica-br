# ============================================================
# Observatório da Política Brasileira - Variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env em branco ou preenchido.

# ---------- Supabase (web + ETL) ----------
# Encontre em https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública (safe para o browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave de serviço (SOMENTE server-side; usada pelo ETL)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Connection string direta ao Postgres (ETL e migrations)
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/observatorio

# ---------- Fontes de dados ----------
# Portal da Transparência (cadastro gratuito em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
TRANSPARENCIA_API_TOKEN=

# INLABS (DOU) - cadastro em https://inlabs.in.gov.br/
INLABS_EMAIL=
INLABS_PASSWORD=

# ---------- Observabilidade (opcional) ----------
SENTRY_DSN=
VERCEL_ANALYTICS_ID=

# ---------- Email (Fase 5) ----------
RESEND_API_KEY=
ALERT_FROM_EMAIL=observatorio@example.com

# ---------- Dev flags ----------
# Permite rodar o ETL em dry-run (sem gravar no banco)
ETL_DRY_RUN=false
# Limita quantidade de parlamentares processados em dev
ETL_LIMIT=
